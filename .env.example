# Copy to .env and adjust: cp .env.example .env
# Docker Compose reads .env automatically. The backend also reads it when run
# outside Docker (from the backend/ directory).

# --- Database (PostgreSQL + PostGIS) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
# Port exposed on your machine (the backend in Docker always uses 5432 internally)
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
BACKEND_PORT=8000
# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# --- Client (React + Vite) ---
CLIENT_PORT=5173
